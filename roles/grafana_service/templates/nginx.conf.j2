# NGINX configuration for Grafana
# Generated by Ansible

# Redirect HTTP to HTTPS
server {
    listen 80;
    server_name {{ grafana_domains | join(' ') }};
    return 301 https://$host$request_uri;
}

# HTTPS server
server {
    listen 443 ssl;
    http2 on;

    server_name {{ grafana_domains | join(' ') }};

    # SSL configuration
    ssl_certificate /etc/letsencrypt/live/{{ grafana_primary_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ grafana_primary_domain }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Log files
    access_log /var/log/nginx/grafana-access.log;
    error_log /var/log/nginx/grafana-error.log;

    # Proxy to Grafana
    location / {
        proxy_pass http://127.0.0.1:{{ grafana_port }};

        # Proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
