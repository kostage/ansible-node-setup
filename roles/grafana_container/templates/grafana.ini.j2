# Grafana configuration file
# Generated by Ansible - Do not edit manually
# For more information: https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/

{% if grafana_ini_config is defined %}
{% for section, settings in grafana_ini_config.items() %}
[{{ section }}]
{% for key, value in settings.items() %}
{{ key }} = {{ value }}
{% endfor %}

{% endfor %}
{% endif %}

# Additional paths configuration
[paths]
data = /var/lib/grafana
logs = /var/lib/grafana/logs
plugins = /var/lib/grafana/plugins
provisioning = /etc/grafana/provisioning
