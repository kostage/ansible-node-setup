[Unit]
Description=Grafana Container Service (Podman)
Documentation=https://grafana.com/docs/grafana/latest/
After=network-online.target podman.service
Wants=network-online.target
Requires=podman.service

[Service]
Type=simple

# Pull the latest image before starting
ExecStartPre=-/usr/bin/podman pull {{ grafana_container_image }}
ExecStartPre=-/usr/bin/podman stop {{ grafana_container_name }}
ExecStartPre=-/usr/bin/podman rm {{ grafana_container_name }}

# Main container start command
ExecStart=/usr/bin/podman run --name {{ grafana_container_name }} \
  --publish {{ grafana_container_port }}:3000 \
  --volume {{ grafana_container_data_dir }}:/var/lib/grafana:Z \
  --user {{ grafana_container_uid }}:{{ grafana_container_gid }} \
  --env GF_SECURITY_ADMIN_USER={{ grafana_admin_user }} \
  --env GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }} \
  --env GF_PATHS_DATA=/var/lib/grafana \
  --env GF_PATHS_HOME=/usr/share/grafana \
  --env GF_PATHS_LOGS=/var/lib/grafana/logs \
  --env GF_PATHS_PLUGINS=/var/lib/grafana/plugins \
  --env GF_PATHS_PROVISIONING=/etc/grafana/provisioning \
  --health-cmd="/usr/bin/wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1" \
  --health-interval=30s \
  --health-timeout=10s \
  --health-retries=3 \
  --health-start-period=60s \
  --log-driver=journald \
  --rm \
  {{ grafana_container_image }}

# Stop command
ExecStop=/usr/bin/podman stop -t 30 {{ grafana_container_name }}

# Restart policy
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
