[Unit]
Description=Grafana Service (Rootless Podman)
Documentation=https://grafana.com/docs/grafana/latest/
After=network-online.target
Wants=network-online.target
Requires=grafana-data.volume

[Container]
Image={{ grafana_container_image }}
ContainerName={{ grafana_container_name }}
PublishPort={{ grafana_container_port }}:3000

# Data persistence using named volume
Volume={{ grafana_container_volume_name }}:/var/lib/grafana:Z

# Mount custom grafana.ini configuration
Volume={{ grafana_container_home }}/grafana.ini:/etc/grafana/grafana.ini:ro,Z

# Set container user to match Grafana's expected UID
User=472
Group=472

# Environment variables for basic configuration
Environment=GF_PATHS_CONFIG=/etc/grafana
Environment=GF_PATHS_DATA=/var/lib/grafana
Environment=GF_PATHS_HOME=/usr/share/grafana
Environment=GF_PATHS_LOGS=/var/lib/grafana/logs
Environment=GF_PATHS_PLUGINS=/var/lib/grafana/plugins
Environment=GF_PATHS_PROVISIONING=/etc/grafana/provisioning

# Container restart policy
# Auto-update on image changes (only works with Quadlet)
AutoUpdate=registry

# Health check
HealthCmd=/usr/bin/wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s

# Resource limits (optional)
# MemoryLimit=512M
# CPUQuota=2

# Podman-specific options
# Add SELinux context with :Z flag on volumes above
# Enable container logging
LogDriver=journald

[Service]
# Restart policy for the systemd service
Restart=always
RestartSec=10s

# Timeout for startup
TimeoutStartSec=300
TimeoutStopSec=30

# Security options
# NoNewPrivileges=true
# PrivateTmp=true

[Install]
WantedBy=default.target
